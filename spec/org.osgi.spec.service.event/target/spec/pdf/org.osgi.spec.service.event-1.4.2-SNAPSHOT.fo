               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Framework Events must be delivered asynchronously with a topic
      of:</fo:block>
               <fo:block space-before.minimum="0.8em"
                         space-before.optimum="1em"
                         space-before.maximum="1.2em"
                         space-after.minimum="0.8em"
                         space-after.optimum="1em"
                         space-after.maximum="1.2em"
                         hyphenate="false"
                         wrap-option="no-wrap"
                         white-space-collapse="false"
                         white-space-treatment="preserve"
                         linefeed-treatment="preserve"
                         text-align="start"
                         font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                         font-size="9pt"
                         letter-spacing="-.0em"
                         space-before="5pt"
                         space-after="3pt"
                         space-after.conditionality="retain"
                         start-indent="inherit"
                         line-height="11pt"
                         id="d249e622">org/osgi/framework/BundleEvent/&lt;event type&gt;</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The following event types are supported:</fo:block>
               <fo:block space-before.minimum="0.8em"
                         space-before.optimum="1em"
                         space-before.maximum="1.2em"
                         space-after.minimum="0.8em"
                         space-after.optimum="1em"
                         space-after.maximum="1.2em"
                         hyphenate="false"
                         wrap-option="no-wrap"
                         white-space-collapse="false"
                         white-space-treatment="preserve"
                         linefeed-treatment="preserve"
                         text-align="start"
                         font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                         font-size="9pt"
                         letter-spacing="-.0em"
                         space-before="5pt"
                         space-after="3pt"
                         space-after.conditionality="retain"
                         start-indent="inherit"
                         line-height="11pt"
                         id="d249e624">INSTALLED
STARTED
STOPPED
UPDATED
UNINSTALLED
RESOLVED
UNRESOLVED</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Unknown events must be ignored.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The following event properties must be set for a Bundle Event. If
      listeners require synchronous delivery then they should register a
      Synchronous Bundle Listener with the Framework.</fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d249e627">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d249e628">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">event</fo:inline> - (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">BundleEvent</fo:inline>) The original
          event object.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d249e634">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">bundle.id - (Long</fo:inline>) The source's bundle id.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d249e638">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">bundle.symbolicName</fo:inline> - (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">String)</fo:inline> The
          source bundle's symbolic name. Only set if the bundle's symbolic
          name is not <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">null</fo:inline>.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d249e646">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">bundle.version</fo:inline> - <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">(Version)</fo:inline> The
          version of the bundle, if set.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d249e652">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">bundle.signer</fo:inline> -
          <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">(String|Collection&lt;String&gt;)</fo:inline> The DNs of the
          signers.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d249e658">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">bundle</fo:inline> - (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">Bundle</fo:inline>) The source
          bundle.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
            </fo:block>
            <fo:block id="service.event.serviceevent">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>113.6.5</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Service Event</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Service Events must be delivered asynchronously with the
      topic:</fo:block>
               <fo:block space-before.minimum="0.8em"
                         space-before.optimum="1em"
                         space-before.maximum="1.2em"
                         space-after.minimum="0.8em"
                         space-after.optimum="1em"
                         space-after.maximum="1.2em"
                         hyphenate="false"
                         wrap-option="no-wrap"
                         white-space-collapse="false"
                         white-space-treatment="preserve"
                         linefeed-treatment="preserve"
                         text-align="start"
                         font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                         font-size="9pt"
                         letter-spacing="-.0em"
                         space-before="5pt"
                         space-after="3pt"
                         space-after.conditionality="retain"
                         start-indent="inherit"
                         line-height="11pt"
                         id="d249e667">org/osgi/framework/ServiceEvent/&lt;eventtype&gt;</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The following event types are supported:</fo:block>
               <fo:block space-before.minimum="0.8em"
                         space-before.optimum="1em"
                         space-before.maximum="1.2em"
                         space-after.minimum="0.8em"
                         space-after.optimum="1em"
                         space-after.maximum="1.2em"
                         hyphenate="false"
                         wrap-option="no-wrap"
                         white-space-collapse="false"
                         white-space-treatment="preserve"
                         linefeed-treatment="preserve"
                         text-align="start"
                         font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                         font-size="9pt"
                         letter-spacing="-.0em"
                         space-before="5pt"
                         space-after="3pt"
                         space-after.conditionality="retain"
                         start-indent="inherit"
                         line-height="11pt"
                         id="d249e669">REGISTERED
MODIFIED
UNREGISTERING</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Unknown events must be ignored.</fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d249e671">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d249e672">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">event</fo:inline> - (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">ServiceEvent</fo:inline>) The original
          Service Event object.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d249e678">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">service</fo:inline> - (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">ServiceReference</fo:inline>) The
          result of the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">getServiceReference</fo:inline> method</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d249e686">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">service.id</fo:inline> - (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">Long</fo:inline>) The service's
          ID.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d249e692">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">service.pid</fo:inline> - (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">String or
          Collection&lt;String&gt;</fo:inline>) The service's persistent identity.
          Only set if not <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">null</fo:inline>. If the PID is specified as a
          <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">String[]</fo:inline> then it must be coerced into a
          <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">Collection&lt;String&gt;</fo:inline>.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d249e704">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">service.objectClass</fo:inline> - (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">String[]</fo:inline>) The
          service's object class.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
            </fo:block>
            <fo:block id="d249e710">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>113.6.6</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Other Event Sources</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Several OSGi service specifications define their own event model.
      It is the responsibility of these services to map their events to Event
      Admin events. Event Admin is seen as a core service that will be present
      in most devices. However, if there is no Event Admin service present,
      applications are not mandated to buffer events.</fo:block>
            </fo:block>
         </fo:block>
         <fo:block id="d249e713">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Event Admin Service</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>113.7</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Event Admin Service</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The Event Admin service must be registered as a service with the
    object class <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">org.osgi.service.event.EventAdmin</fo:inline>. Multiple
    Event Admin services can be registered. Publishers should publish their
    event on the Event Admin service with the highest value for the
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">SERVICE_RANKING</fo:inline> service property. This is the service
    selected by the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">getServiceReference</fo:inline> method.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The Event Admin service is responsible for tracking the registered
    handlers, handling event notifications and providing at least one thread
    for asynchronous event delivery.</fo:block>
            <fo:block id="d249e724">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>113.7.1</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Synchronous Event Delivery</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Synchronous event delivery is initiated by the
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">sendEvent</fo:inline> method. When this method is invoked, the Event
      Admin service determines which handlers must be notified of the event
      and then notifies each one in turn. The handlers can be notified in the
      caller's thread or in an event-delivery thread, depending on the
      implementation. In either case, all notifications must be completely
      handled before the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">sendEvent</fo:inline> method returns to the
      caller.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Synchronous event delivery is significantly more expensive than
      asynchronous delivery. All things considered equal, the asynchronous
      delivery should be preferred over the synchronous delivery.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Callers of this method will need to be coded defensively and
      assume that synchronous event notifications could be handled in a
      separate thread. That entails that they must not be holding any monitors
      when they invoke the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">sendEvent</fo:inline> method. Otherwise they
      significantly increase the likelihood of deadlocks because Java monitors
      are not reentrant from another thread by definition. Not holding
      monitors is good practice even when the event is dispatched in the same
      thread.</fo:block>
            </fo:block>
            <fo:block id="d249e737">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>113.7.2</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Asynchronous Event Delivery</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Asynchronous event delivery is initiated by the
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">postEvent</fo:inline> method. When this method is invoked, the Event
      Admin service must determine which handlers are interested in the event.
      By collecting this list of handlers during the method invocation, the
      Event Admin service ensures that only handlers that were registered at
      the time the event was posted will receive the event notification. This
      is the same as described in <fo:inline font-style="italic">Delivering Events</fo:inline> of
      <fo:inline color="inherit"
                             font-family="inherit"
                             letter-spacing="inherit"
                             hyphenate="inherit">???</fo:inline>.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The Event Admin service can use more than one thread to deliver
      events. If it does then it must guarantee that each handler receives the
      events in the same order as the events were posted, unless this handler
      allows unordered deliver, see <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="i1556001">
                     <fo:inline color="inherit"
                                font-family="inherit"
                                letter-spacing="inherit"
                                hyphenate="inherit">
                        <fo:inline font-style="italic">Ordering</fo:inline> on page <fo:page-number-citation ref-id="i1556001"/>
                     </fo:inline>
                  </fo:basic-link>. This ensures
      that handlers see events in their expected order. For example, for some
      handlers it would be an error to see a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">destroyed</fo:inline> event
      before the corresponding <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">created</fo:inline> event.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Before notifying each handler, the event delivery thread must
      ensure that the handler is still registered in the service registry. If
      it has been unregistered then the handler must not be notified.</fo:block>
            </fo:block>
            <fo:block id="d249e756">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>113.7.3</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Order of Event Delivery</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Asynchronous events are delivered in the order in which they
      arrive in the event queue. Thus if two events are posted by the same
      thread then they will be delivered in the same order (though other
      events may come between them). However, if two or more events are posted
      by different threads then the order in which they arrive in the queue
      (and therefore the order in which they are delivered) will depend very
      much on subtle timing issues. The event delivery system cannot make any
      guarantees in this case. An Event Handler can indicate that the ordering
      is not relevant, allowing the Event Admin to more aggressively
      parallelize the event deliver, see <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="i1556001">
                     <fo:inline color="inherit"
                                font-family="inherit"
                                letter-spacing="inherit"
                                hyphenate="inherit">
                        <fo:inline font-style="italic">Ordering</fo:inline> on page <fo:page-number-citation ref-id="i1556001"/>
                     </fo:inline>
                  </fo:basic-link>.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Synchronous events are delivered as soon as they are sent. If two
      events are sent by the same thread, one after the other, then they must
      be guaranteed to be processed serially and in the same order. However,
      if two events are sent by different threads then no guarantees can be
      made. The events can be processed in parallel or serially, depending on
      whether or not the Event Admin service dispatches synchronous events in
      the caller's thread or in a separate thread.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Note that if the actions of a handler trigger a synchronous event,
      then the delivery of the first event will be paused and delivery of the
      second event will begin. Once delivery of the second event has
      completed, delivery of the first event will resume. Thus some handlers
      may observe the second event before they observe the first one.</fo:block>
            </fo:block>
         </fo:block>
         <fo:block id="d249e764">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Reliability</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>113.8</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Reliability</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block id="d249e766">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>113.8.1</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Exceptions in callbacks</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">If a handler throws an Exception during delivery of an event, it
      must be caught by the Event Admin service and handled in some
      implementation specific way. If a Log Service is available the exception
      should be logged. Once the exception has been caught and dealt with, the
      event delivery must continue with the next handlers to be notified, if
      any.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">As the Log Service can also forward events through the Event Admin
      service there is a potential for a loop when an event is reported to the
      Log Service.</fo:block>
            </fo:block>
            <fo:block id="d249e770">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>113.8.2</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Dealing with Stalled Handlers</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Event handlers should not spend too long in the
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">handleEvent</fo:inline> method. Doing so will prevent other handlers in
      the system from being notified. If a handler needs to do something that
      can take a while, it should do it in a different thread.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">An event admin implementation can attempt to detect stalled or
      deadlocked handlers and deal with them appropriately. Exactly how it
      deals with this situation is left as implementation specific. One
      allowed implementation is to mark the current event delivery thread as
      invalid and spawn a new event delivery thread. Event delivery must
      resume with the next handler to be notified.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Implementations can choose to deny list any handlers that they
      determine are misbehaving. Deny listed handlers must not be notified of
      any events. If a handler is deny listed, the event admin should log a
      message that explains the reason for it.</fo:block>
            </fo:block>
         </fo:block>
         <fo:block id="d249e778">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Interoperability with Native Applications</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>113.9</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Interoperability with Native Applications</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Implementations of the Event Admin service can support passing
    events to, and/or receiving events from native applications.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">If the implementation supports native interoperability, it must be
    able to pass the topic of the event and its properties to/from native
    code. Implementations must be able to support property values of the
    following types:</fo:block>
            <fo:list-block space-before.optimum="1em"
                           space-before.minimum="0.8em"
                           space-before.maximum="1.2em"
                           space-after.optimum="1em"
                           space-after.minimum="0.8em"
                           space-after.maximum="1.2em"
                           provisional-label-separation="0.2em"
                           provisional-distance-between-starts="12pt"
                           id="d249e782">
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d249e783">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">String</fo:inline> objects, including full Unicode
        support</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d249e787">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">Integer, Long, Byte, Short, Float, Double, Boolean,
        Character</fo:inline> objects</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d249e791">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>Single-dimension arrays of the above types (including
        <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">String</fo:inline>)</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d249e796">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>Single-dimension arrays of Java's eight primitive types
        (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">int, long, byte, short, float, double, boolean,
        char</fo:inline>)</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Implementations can support additional types. Property values of
    unsupported types must be silently discarded.</fo:block>
         </fo:block>
         <fo:block id="service.event-capabilities">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Capabilities</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>113.10</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Capabilities</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block id="d249e805">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>113.10.1</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>osgi.implementation Capability</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The Event Admin implementation bundle must provide the <fo:inline color="inherit"
                             font-family="inherit"
                             letter-spacing="inherit"
                             hyphenate="inherit">
                     <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                font-size="9pt"
                                letter-spacing="0.08em">osgi.implementation</fo:inline>
                  </fo:inline>
      capability with the name <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.event.EventConstants.EVENT_ADMIN_IMPLEMENTATION">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">EVENT_ADMIN_IMPLEMENTATION</fo:inline>
                  </fo:basic-link>. This capability can be used by provisioning
      tools and during resolution to ensure that an Event Admin implementation
      is present. The capability must also declare a uses constraint for the
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">org.osgi.service.event</fo:inline> package and provide the version of
      this specification:</fo:block>
               <fo:block space-before.minimum="0.8em"
                         space-before.optimum="1em"
                         space-before.maximum="1.2em"
                         space-after.minimum="0.8em"
                         space-after.optimum="1em"
                         space-after.maximum="1.2em"
                         hyphenate="false"
                         wrap-option="no-wrap"
                         white-space-collapse="false"
                         white-space-treatment="preserve"
                         linefeed-treatment="preserve"
                         text-align="start"
                         font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                         font-size="9pt"
                         letter-spacing="-.0em"
                         space-before="5pt"
                         space-after="3pt"
                         space-after.conditionality="retain"
                         start-indent="inherit"
                         line-height="11pt"
                         id="d249e816">Provide-Capability: osgi.implementation;
       osgi.implementation="osgi.event";
       uses:="org.osgi.service.event";
       version:Version="<fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.event">
                     <fo:inline color="inherit"
                                font-family="inherit"
                                letter-spacing="inherit"
                                hyphenate="inherit">1.4</fo:inline>
                  </fo:basic-link>"</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.event.annotations.RequireEventAdmin">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">RequireEventAdmin</fo:inline>
                  </fo:basic-link> annotation can be used to require this
      capability.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">This capability must follow the rules defined for the <fo:inline color="inherit"
                             font-family="inherit"
                             letter-spacing="inherit"
                             hyphenate="inherit">???</fo:inline>.</fo:block>
            </fo:block>
            <fo:block id="d249e828">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>113.10.2</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>osgi.service Capability</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The bundle providing the Event Admin service must provide a
      capability in the <fo:inline color="inherit"
                             font-family="inherit"
                             letter-spacing="inherit"
                             hyphenate="inherit">
                     <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                font-size="9pt"
                                letter-spacing="0.08em">osgi.service</fo:inline>
                  </fo:inline>
      namespace representing this service. This capability must also declare a
      uses constraint for the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">org.osgi.service.event</fo:inline>
      package:</fo:block>
               <fo:block space-before.minimum="0.8em"
                         space-before.optimum="1em"
                         space-before.maximum="1.2em"
                         space-after.minimum="0.8em"
                         space-after.optimum="1em"
                         space-after.maximum="1.2em"
                         hyphenate="false"
                         wrap-option="no-wrap"
                         white-space-collapse="false"
                         white-space-treatment="preserve"
                         linefeed-treatment="preserve"
                         text-align="start"
                         font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                         font-size="9pt"
                         letter-spacing="-.0em"
                         space-before="5pt"
                         space-after="3pt"
                         space-after.conditionality="retain"
                         start-indent="inherit"
                         line-height="11pt"
                         id="d249e837">Provide-Capability: osgi.service;
  objectClass:List&lt;String&gt;="org.osgi.service.event.EventAdmin";
  uses:="org.osgi.service.event"</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">This capability must follow the rules defined for the <fo:inline color="inherit"
                             font-family="inherit"
                             letter-spacing="inherit"
                             hyphenate="inherit">???</fo:inline>.</fo:block>
            </fo:block>
         </fo:block>
         <fo:block id="d249e842">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Security</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>113.11</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Security</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block id="d249e844">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>113.11.1</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Topic Permission</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">TopicPermission</fo:inline> class allows fine-grained control
      over which bundles may post events to a given topic and which bundles
      may receive those events.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The target parameter for the permission is the topic name.
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">TopicPermission</fo:inline> classes uses a wildcard matching algorithm
      similar to the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">BasicPermission</fo:inline> class, except that solidi
      (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">'/' \u002F</fo:inline>) are used as separators instead of full stop
      characters. For example, a name of <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">a/b/*</fo:inline> implies
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">a/b/c</fo:inline> but not <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">x/y/z</fo:inline> or
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">a/b</fo:inline>.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">There are two available actions: <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">PUBLISH</fo:inline> and
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">SUBSCRIBE</fo:inline>. These control a bundle's ability to either
      publish or receive events, respectively. Neither one implies the
      other.</fo:block>
            </fo:block>
            <fo:block id="d249e873">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>113.11.2</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Required Permissions</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Bundles that need to register an event handler must be granted
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">ServicePermission</fo:inline>[<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">org.osgi.service.event.EventHandler</fo:inline>,
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">REGISTER</fo:inline>]. In addition, handlers require
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">TopicPermission[ &lt;topic&gt;, SUBSCRIBE ]</fo:inline> for each topic
      they want to be notified about.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Bundles that need to publish an event must be granted
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">ServicePermission[ org.osgi.service.event.EventAdmin, GET]</fo:inline>
      so that they may retrieve the Event Admin service and use it. In
      addition, event sources require <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">TopicPermission[ &lt;topic&gt;,
      PUBLISH]</fo:inline> for each topic they want to send events to.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Bundles that need to iterate the handlers registered with the
      system must be granted
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">ServicePermission[org.osgi.service.event.EventHandler, GET]</fo:inline>
      to retrieve the event handlers from the service registry.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Only a bundle that contains an Event Admin service implementation
      should be granted <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">ServicePermission[
      org.osgi.service.event.EventAdmin, REGISTER]</fo:inline> to register the
      event channel admin service.</fo:block>
            </fo:block>
            <fo:block id="d249e899">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>113.11.3</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Security Context During Event Callbacks</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">During an event notification, the Event Admin service's Protection
      Domain will be on the stack above the handler's Protection Domain. In
      the case of a synchronous event, the event publisher's protection domain
      can also be on the stack.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Therefore, if a handler needs to perform a secure operation using
      its own privileges, it must invoke the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">doPrivileged</fo:inline> method
      to isolate its security context from that of its caller.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The event delivery mechanism must not wrap event notifications in
      a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">doPrivileged</fo:inline> call.</fo:block>
            </fo:block>
         </fo:block>
         <fo:block id="org.osgi.service.event">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">org.osgi.service.event</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>113.12</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>org.osgi.service.event<fo:inline id="org.osgi.service.event-version"/>
                                       </fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block keep-together.within-column="always"/>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">
Event Admin Package Version 1.4.
 </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">
 Bundles wishing to use this package must list the package in the
 Import-Package header of the bundle's manifest. This package has two types of
 users: the consumers that use the API in this package and the providers that
 implement the API in this package.
 </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">
 Example import for consumers using the API in this package:
 </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">
 {@code  Import-Package: org.osgi.service.event; version="[1.4,2.0)"}
 </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">
 Example import for providers implementing the API in this package:
 </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">
 {@code  Import-Package: org.osgi.service.event; version="[1.4,1.5)"}</fo:block>
            <fo:block id="d249e923">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>113.12.1</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Summary</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d249e925">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d249e926">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.event.Event">
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">
                                    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">Event</fo:inline>
                                 </fo:inline>
                              </fo:basic-link> - 
An event.
   </fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d249e934">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.event.EventAdmin">
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">
                                    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">EventAdmin</fo:inline>
                                 </fo:inline>
                              </fo:basic-link> - 
The Event Admin service.
   </fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d249e942">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.event.EventConstants">
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">
                                    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">EventConstants</fo:inline>
                                 </fo:inline>
                              </fo:basic-link> - 
Defines standard names for {@code EventHandler} properties.
   </fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d249e950">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
