               <fo:block id="org.osgi.service.event.EventConstants.DELIVERY_ASYNC_ORDERED">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
                                  margin-left="0pt"
                                  font-family="ProductusSemibold,ArialUnicodeMS">
