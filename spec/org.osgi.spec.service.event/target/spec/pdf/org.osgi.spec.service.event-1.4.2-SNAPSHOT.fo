                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>{@code true} if {@code obj} is a {@code TopicPermission}, and has
         the same topic name and actions as this {@code TopicPermission}
         object; {@code false} otherwise.</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
