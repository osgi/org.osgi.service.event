                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>
Create an EventProperties from the specified properties.
 
 </fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">
 The specified properties will be copied into this EventProperties.
 Properties whose key is not of type {@code String} will be ignored. A
 property with the key "event.topics" will be ignored.</fo:block>
               </fo:block>
