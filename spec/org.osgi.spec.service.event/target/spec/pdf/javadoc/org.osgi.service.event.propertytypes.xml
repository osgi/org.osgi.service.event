   <section xreflabel="EventDelivery"
            role="class"
            xml:id="org.osgi.service.event.propertytypes.EventDelivery">
      <title>@EventDelivery</title>
      <para>
Component Property Type for the {@link EventConstants#EVENT_DELIVERY} service
 property of an {@link EventHandler} service.
 </para>
      <para>
 This annotation can be used on an {@link EventHandler} component to declare
 the value of the {@link EventConstants#EVENT_DELIVERY} service property.</para>
      <formalpara role="parameter">
         <title>See Also</title>
         <para>
            <code>Component Property Types</code>
         </para>
      </formalpara>
      <formalpara role="parameter">
         <title>Since</title>
         <para>@since 1.4</para>
      </formalpara>
      <formalpara role="parameter">
         <title>Retention</title>
         <para>
            <code>CLASS</code>
         </para>
      </formalpara>
      <formalpara role="parameter">
         <title>Target</title>
         <para>
            <code>TYPE</code>
         </para>
      </formalpara>
      <section xreflabel="value"
               role="method"
               xml:id="org.osgi.service.event.propertytypes.EventDelivery.value--">
         <title>String[][] value</title>
         <para role="description">
Service property specifying the {@code Event} delivery qualities
 requested by an {@link EventHandler} service.
 </para>
         <para>
 The supported delivery qualities are:
 </para>
         <itemizedlist>
            <listitem>
               <para>{@link EventConstants#DELIVERY_ASYNC_ORDERED}</para>
            </listitem>
            <listitem>
               <para>{@link EventConstants#DELIVERY_ASYNC_UNORDERED}}</para>
            </listitem>
         </itemizedlist>
         <formalpara role="parameter">
            <title>Returns</title>
            <para>The requested event delivery qualities.</para>
         </formalpara>
         <formalpara role="parameter">
            <title>See Also</title>
            <para>
               <link linkend="UNRESOLVED">EventConstants.EVENT_DELIVERY</link>
            </para>
         </formalpara>
      </section>
   </section>
